{
  "name": "iron-forge",
  "version": "1.0.0",
  "category": "coding",
  "description": "Coding Workflow: Verified development loop with dedicated linting, functional testing, and deep-reasoning validation (Develop -> Lint -> Test -> Validate -> Commit).",
  "dependencies": {
    "opencode": "installed",
    "beads": "initialized"
  },
  "components": {
    "opencode_agents": [
      "ashep-tester-lint.md",
      "ashep-tester-functional.md",
      "ashep-tester-system.md",
      "ashep-task-completion-validator.md",
      "ashep-github-master.md"
    ],
    "agent_registries": ["iron-agents.yaml"],
    "workflows": ["iron-policy.yaml"]
  },
  "compatibility": {
    "min_agent_shepherd_version": "0.3.0"
  }
}
